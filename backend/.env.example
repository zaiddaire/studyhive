# StudyHive API - environment variables (placeholders only; never commit real values).
# On Railway set these in the service's Variables tab. PORT is provided by Railway automatically.

SPRING_PROFILES_ACTIVE=prod

# --- Aiven MySQL (Service overview -> Connection information) ---
DB_HOST=your-service-your-project.aivencloud.com
DB_PORT=12345
DB_NAME=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=replace-with-aiven-password
# TLS: VERIFY_CA validates Aiven's certificate against the CA below (do not use DISABLED).
DB_SSL_MODE=VERIFY_CA
# Paste the full contents of Aiven's "CA certificate" (ca.pem), including BEGIN/END lines.
# Base64 of the PEM is also accepted if your platform strips newlines.
DB_SSL_CA_PEM=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
DB_POOL_SIZE=5

# --- Web app ---
# Your Vercel URL(s), comma separated. Used for CORS and links in emails.
FRONTEND_ORIGIN=https://your-app.vercel.app
PUBLIC_APP_URL=https://your-app.vercel.app
APP_TIME_ZONE=Asia/Kolkata
COOKIE_SECURE=true
COOKIE_SAME_SITE=Lax

# --- First administrator (one-time). Remove the password after the first successful start. ---
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=StudyHive Administrator

# --- Optional: email for password resets ---
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# --- Optional ---
# Exclude the sample rooms on a brand-new database (decide before the first start):
# FLYWAY_LOCATIONS=classpath:db/migration
# Expose Swagger UI in production (off by default):
# API_DOCS_ENABLED=false
