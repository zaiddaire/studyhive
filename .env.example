# Local development only - copy to .env and fill in. .env is git-ignored.
DB_NAME=studyhive
DB_USERNAME=studyhive
DB_PASSWORD=change-me-local-db-password
MYSQL_ROOT_PASSWORD=change-me-local-root-password
DB_PORT=3306

FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
APP_TIME_ZONE=Asia/Kolkata

# Optional: creates the first administrator on startup if no account with this email exists.
# Password: 12-64 characters with letters and digits. Remove it from the environment after the first start.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
