# Frontend build-time settings. Only PUBLIC values belong here - everything in VITE_* ships to the browser.

# Leave empty (recommended) so the app calls /api on its own origin:
#  - locally, the Vite dev server proxies /api to Spring Boot (see DEV_API_PROXY_TARGET)
#  - on Vercel, vercel.json rewrites /api to the Railway backend, keeping cookies first-party
# Set an absolute URL only if you serve the API from the same site under another path.
VITE_API_BASE_URL=

# Optional support address shown in the footer. Leave empty to show a generic "contact your administrator" note.
VITE_SUPPORT_EMAIL=

# Local development only (not used in builds): where the Vite dev proxy forwards /api.
DEV_API_PROXY_TARGET=http://localhost:8080
